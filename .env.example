# copy to .env — never committed
PROFILE=tom
POSTIZ_KEY=                     # Postiz → Settings → Public API

# Substack. Cookie string is the reliable one: password login trips captchas and magic links.
# Get it from a logged-in browser: DevTools → Network → any request → Request Headers → cookie
SUBSTACK_COOKIES=
SUBSTACK_EMAIL=                 # fallback; without either, substack.md is written for manual paste
SUBSTACK_PASSWORD=
